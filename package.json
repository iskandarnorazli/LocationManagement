{
  "name": "location-management",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-skill-mirror.mjs && node scripts/check-state-machines.mjs && node scripts/check-ux.mjs",
    "ci": "npm run lint && npm run check:lint-rules && npm run typecheck && npm run check:docs && npm test && npm run build",
    "e2e": "playwright test --project=e2e",
    "format": "prettier --write .",
    "check:lint-rules": "node scripts/check-lint-rules.mjs",
    "snapshots": "playwright test --project=snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
